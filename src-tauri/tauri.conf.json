{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pezli Editor",
  "version": "1.0.0",
  "identifier": "com.pezli.editor",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pezli Editor",
        "width": 1280,
        "height": 720,
        "minWidth": 700,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A lightweight, feature-rich desktop text editor",
    "longDescription": "Pezli Editor is a keyboard-driven desktop text and code editor with a rearrangeable workspace, themes, undo/redo, find and replace, and native file dialogs."
  }
}
